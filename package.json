{
  "name": "appium-login-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Android login test automation with Appium and WebdriverIO",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:staging": "cross-env ENV=staging wdio run wdio.conf.js",
    "test:prod": "cross-env ENV=production wdio run wdio.conf.js",
    "postinstall": "appium driver install uiautomator2"
  },
  "devDependencies": {
    "@wdio/appium-service": "^8.40.0",
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/mocha-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "appium": "3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "tesseract.js": "^7.0.0"
  }
}
