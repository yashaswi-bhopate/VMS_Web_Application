# Select staging or production. The default is staging.
ENV=staging

# Android emulator/device shown by `adb devices`.
DEVICE_NAME=emulator-5554

# App identifiers; replace these with values from your APK.
APP_PACKAGE=com.example.loginapp
APP_ACTIVITY=.MainActivity

# Build paths can be customized. APP_PATH overrides the selected build path.
STAGING_APP_PATH=./app/your-app.apk
PRODUCTION_APP_PATH=./app/production.apk
# APP_PATH=./app/your-app.apk
